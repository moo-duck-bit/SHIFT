# Copy to .env and fill in. .env is gitignored — never commit the filled version.
# Expo inlines EXPO_PUBLIC_* into the JS bundle, so these ship inside the APK.
# Anything here is readable by anyone who has the app. See README > Privacy.

# VLM (OpenRouter)
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_SITE_URL=
EXPO_PUBLIC_SITE_NAME=

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
